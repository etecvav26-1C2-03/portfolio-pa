# Descrição: Lê 10 números e conta quantos são positivos, negativos e zeros.

contador = 1
positivos = 0
negativos = 0
zeros = 0

while contador <= 10:
    numero = int(input(f"Digite o {contador}o numero: "))

    if numero > 0:
        positivos += 1
    elif numero < 0:
        negativos += 1
    else:
        zeros += 1

    contador += 1

print(f"Positivos: {positivos}")
print(f"Negativos: {negativos}")
print(f"Zeros: {zeros}")
